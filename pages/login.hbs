<section class="portal-section">
  <div class="container">
    <div class="portal-card">
      <p class="eyebrow">Nordel Account</p>
      <h1>Sign In</h1>
      <p class="lead">Access your VPN key, servers, and connected devices.</p>
      <form class="portal-form" data-portal-login>
        <div class="portal-status" data-portal-status hidden role="status"></div>
        <label class="portal-field">
          <span>Email</span>
          <input type="email" name="email" required autocomplete="email" placeholder="you@example.com">
        </label>
        <label class="portal-field">
          <span>Password</span>
          <input type="password" name="password" required autocomplete="current-password" placeholder="••••••••">
        </label>
        <button class="button" type="submit">Sign In ↗</button>
      </form>
      <div class="portal-links">
        <a href="./forgot-password.html">Forgot password?</a>
        <a href="./create-account.html">Create Account</a>
      </div>
    </div>
  </div>
</section>

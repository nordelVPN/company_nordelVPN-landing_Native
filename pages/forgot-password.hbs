<section class="portal-section">
  <div class="container">
    <div class="portal-card">
      <p class="eyebrow">Nordel Account</p>
      <h1>Reset Password</h1>
      <p class="lead">Enter your account email and we will send password reset instructions.</p>
      <form class="portal-form" data-portal-forgot novalidate>
        <div class="portal-status" data-portal-status hidden role="status" aria-live="polite"></div>
        <label class="portal-field">
          <span>Email</span>
          <input type="email" name="email" required autocomplete="email" placeholder="you@example.com">
        </label>
        <button class="button" type="submit">Send Reset Link ↗</button>
        <p class="portal-consent-note">By continuing, you agree to our <a href="./terms.html">Terms of Use</a> and <a href="./privacy.html">Privacy Policy</a>.</p>
      </form>
      <form class="portal-form" data-portal-reset hidden novalidate>
        <div class="portal-status" data-portal-status hidden role="status" aria-live="polite"></div>
        <input type="hidden" name="token">
        <label class="portal-field">
          <span>New Password (min 8 characters)</span>
          <input type="password" name="password" required minlength="8" autocomplete="new-password">
        </label>
        <label class="portal-field">
          <span>Confirm New Password</span>
          <input type="password" name="password_confirmation" required minlength="8" autocomplete="new-password">
        </label>
        <button class="button" type="submit">Set New Password ↗</button>
      </form>
      <div class="portal-links">
        <a href="./login.html">Back to Sign In</a>
        <a href="./create-account.html">Create Account</a>
      </div>
    </div>
  </div>
</section>

<section class="portal-section">
  <div class="container">
    <div class="portal-card">
      <p class="eyebrow">Nordel Account</p>
      <h1>Reset Password</h1>
      <p class="lead">Enter your account email and we will send password reset instructions.</p>
      <form class="portal-form" data-portal-forgot>
        <div class="portal-status" data-portal-status hidden role="status"></div>
        <label class="portal-field">
          <span>Email</span>
          <input type="email" name="email" required autocomplete="email" placeholder="you@example.com">
        </label>
        <button class="button" type="submit">Send Reset Link ↗</button>
      </form>
      <div class="portal-links">
        <a href="./login.html">Back to Sign In</a>
        <a href="./create-account.html">Create Account</a>
      </div>
    </div>
  </div>
</section>

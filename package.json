{
  "name": "nordel-landing",
  "version": "0.1.0",
  "private": true,
  "description": "Nordel VPN static multi-page landing",
  "scripts": {
    "start": "webpack serve --config webpack/webpack.dev.js",
    "build:dev": "webpack --config webpack/webpack.dev.js",
    "build:prod": "webpack --config webpack/webpack.prod.js",
    "build": "npm run build:prod",
    "lint": "eslint src webpack",
    "start:live": "node -e \"const {spawnSync}=require('child_process');process.exit(spawnSync('npm',['start'],{stdio:'inherit',shell:true,env:{...process.env,DATA_MODE:'live',BRAND_SLUG:'nordel',PORT:process.env.PORT||'3001',SITE_PORT:process.env.SITE_PORT||'3001',PORTAL_API_URL:process.env.PORTAL_API_URL||'http://localhost:8081',SERVERS_API_URL:process.env.SERVERS_API_URL||'http://localhost:8082',SERVERS_CATALOG_URL:process.env.SERVERS_CATALOG_URL||'/_api/servers'}}).status||0)\"",
    "start:demo": "node -e \"const {spawnSync}=require('child_process');process.exit(spawnSync('npm',['start'],{stdio:'inherit',shell:true,env:{...process.env,DATA_MODE:'demo',BRAND_SLUG:'nordel',PORT:process.env.PORT||'3001',SITE_PORT:process.env.SITE_PORT||'3001'}}).status||0)\""
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.2.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^9.17.0",
    "handlebars": "^4.7.8",
    "handlebars-loader": "^1.7.3",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "postcss-loader": "^8.1.1",
    "sass": "^1.83.4",
    "sass-loader": "^16.0.4",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.11",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "Firefox ESR",
    "not dead"
  ],
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}

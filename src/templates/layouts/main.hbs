<!doctype html>
<html lang="{{lang}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title data-i18n="{{#if landing}}index{{else}}about{{/if}}.title">{{title}}</title>
  <meta name="description" data-i18n-content="{{#if landing}}index{{else}}about{{/if}}.description" content="{{description}}">
  {{#if canonical}}<link rel="canonical" href="{{canonical}}">{{/if}}
  <meta name="color-scheme" content="light dark">
  {{#if isAccount}}<style>[data-auth-gate][hidden]{display:none!important;}</style><script>(function(){try{if(window.__VPN_PORTAL_CONFIG__&&window.__VPN_PORTAL_CONFIG__.mode==='demo')return;if(!window.localStorage.getItem('nordel-vpn-portal:token')){window.location.replace('./login.html');}}catch(e){window.location.replace('./login.html');}})();</script>{{/if}}
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZL3FK3YC63"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-ZL3FK3YC63');
  </script>
</head>
<body>
  <a class="skip-link" href="#main-content"><span data-i18n="skip">Skip to content</span></a>
  {{> header}}
  <main id="main-content"{{#if isAccount}} hidden data-auth-gate{{/if}}>{{{body}}}</main>
  {{> footer}}
  {{> wishlist}}
</body>
</html>
